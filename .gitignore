Thumbs.db
desktop.ini

# ---------- Local secrets / env ----------
.env
.env.*
!.env.example

# Zero-byte files a mis-quoted notification hook drops in the project root;
# the name is a flattened Windows path, so the glob has to be loose.
C*UsersMadhav*claude-notify-signals*
