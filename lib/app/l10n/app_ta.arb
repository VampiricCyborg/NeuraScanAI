  "taskReactionBody": "{count} முறை வரும். ஒவ்வொன்றுக்கும் முன் காத்திருப்பு நேரம் வேண்டுமென்றே வேறுபடுகிறது, எனவே ஊகிக்க முயற்சிக்க வேண்டாம்.",
  "taskReactionWait": "காத்திருங்கள்",
  "taskReactionTapNow": "தட்டுங்கள்",
  "taskReactionTooEarly": "வட்டம் மாறுவதற்கு முன்பே அது நடந்தது. பச்சைக்காகக் காத்திருங்கள்.",
  "taskReactionTrialProgress": "{total}-இல் {done}",

  "taskSpeechTitle": "நீங்கள் பார்ப்பதை விவரியுங்கள்",
  "taskSpeechBody": "{seconds} வினாடிகள் படத்தைப் பற்றிப் பேசுங்கள். நீங்கள் கவனிப்பதை எதையும் சொல்லுங்கள். சரியான பதில் எதுவும் இல்லை, ஒலிப்பதிவை யாரும் கேட்கமாட்டார்கள்.",
  "taskSpeechRecording": "கேட்கிறது",
  "taskSpeechDeleted": "ஒலிப்பதிவு நீக்கப்பட்டது. இரண்டு அளவீடுகள் மட்டுமே வைக்கப்பட்டன.",
  "taskSpeechMicrophoneNeeded": "இந்தப் பணிக்கு NeuraScan-க்கு ஒலிவாங்கி தேவை. அளவிடப்பட்டவுடன் ஒலிப்பதிவு நீக்கப்படுகிறது.",
  "taskSpeechTooQuiet": "போதுமான பேச்சை எங்களால் கேட்க முடியவில்லை. அமைதியான இடத்தில் மீண்டும் முயலுங்கள்.",

  "taskSpiralTitle": "சுருளைப் பின்தொடருங்கள்",
  "taskSpiralBody": "ஒரு விரலால் நடுவிலிருந்து வெளிப்புறமாக கோட்டைப் பின்தொடருங்கள். அவசரம் வேண்டாம். வேகத்தை விட கோட்டின் மீது சரியாக இருப்பது முக்கியம்.",
  "taskSpiralCoverage": "{percent}% வரையப்பட்டது",
  "taskSpiralIncomplete": "முடிப்பதற்கு முன் சுருளின் பெரும்பகுதியை வரையுங்கள்.",
  "taskSpiralClear": "மீண்டும் தொடங்கு",

  "taskRecallTitle": "எந்த சொற்கள் நினைவில் உள்ளன?",
  "taskRecallBody": "முன்பு காட்டப்பட்ட சொற்களை எந்த வரிசையிலும் தட்டச்சு செய்யுங்கள். எழுத்துப்பிழை சரியாக இருக்க வேண்டியதில்லை.",
  "taskRecallHint": "ஒரு சொல், பிறகு சேர்க்கவும்",
  "taskRecallAdd": "சேர்",
  "taskRecallNoneYet": "இன்னும் சொற்கள் சேர்க்கப்படவில்லை.",
  "taskRecallFinish": "அதுதான் எனக்கு நினைவில் உள்ளது",

